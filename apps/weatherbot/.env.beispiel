# Kopiere diese Datei nach ".env" und trage deine Werte ein.
# Die echte .env wird NIE veröffentlicht (steht in .gitignore).

# Pflicht: Token deines Telegram-Bots vom @BotFather.
TELEGRAM_BOT_TOKEN=

# Optional: Uhrzeit der täglichen Nachricht im Format HH:MM (lokale Serverzeit).
# Standard ist 07:00.
SENDE_ZEIT=07:00

# Optional: Stadt, die neuen Chats beim /start voreingestellt wird.
# Leer lassen, dann stellt jede:r die Stadt selbst mit /stadt ein.
STANDARD_STADT=

# Optional: Pfad zur Datei, in der die Abos gespeichert werden.
# Standard ist abos.json neben index.js.
ABO_DATEI=
